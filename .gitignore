# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Secrets — the Gemini key must never land in the repo
.env
*.key
kaggle.json

# Large artifacts. runs/ keeps manifests and metrics (they are the record);
# checkpoints and feature tensors are reproducible and stay out.
*.pt
*.pth
*.safetensors
runs/**/checkpoint*
# Console logs churn while a run is in flight and duplicate what the record already
# holds: manifest.json has the config and provenance, stats.json the metrics and timings.
runs/*.log
# Git cannot re-include a file whose parent directory is excluded, so the data tree is
# excluded level by level rather than with a blanket /data/.
/data/*
!/data/.gitkeep
!/data/generated/
/data/generated/*
# ...except the small, NON-REPRODUCIBLE evidence files. Generation runs at
# temperature 0.9 against a hosted model, so a caption set cannot be regenerated
# byte-identically and is therefore primary evidence, not a build artifact. These are
# the prompt-iteration audits (5 x 50 images) and the Sonnet reference set, ~1.1 MB
# total. The full corpus is ~28 MB and deliberately stays out.
!/data/generated/captions_audit_*.jsonl
!/data/generated/captions_reference_*.jsonl
# The exclusion register is provenance, not data: a few hundred bytes naming the images
# the generator refuses and why. docs/deviations.md cites it, so it must be in the repo.
!/data/generated/excluded_images.json
# Vertex comparison arms: small, non-reproducible at temperature 0.9, and the evidence
# for the generator-capability comparison. Same rationale as the audit sets.
!/data/generated/captions_vertex_*.jsonl
.DS_Store
.ipynb_checkpoints/

# Flickr8k source data — downloadable, not ours to redistribute
/data/flickr8k/

# GCP service-account keys -- long-lived credentials, never committed
secrets/
*-service-account*.json
